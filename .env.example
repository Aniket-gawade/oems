# MySQL
MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3306
MYSQL_DATABASE=oems
MYSQL_USER=oems_user
MYSQL_PASSWORD=oems_password
MYSQL_ROOT_PASSWORD=oems_root_password

# Redis
REDIS_IMAGE=redis:8.6
REDIS_PORT=6379

# Keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.5
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=oems
KEYCLOAK_CLIENT_ID=oems-api
KEYCLOAK_TRADER_USERNAME=trader1
KEYCLOAK_TRADER_PASSWORD=trader1pass
KEYCLOAK_OPS_USERNAME=ops1
KEYCLOAK_OPS_PASSWORD=ops1pass

# Optional observability stack
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional frontend web service
WEB_PORT=5173
WEB_API_PROXY_TARGET=http://oems-api:8080
