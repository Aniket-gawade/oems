# Web app runtime
WEB_PORT=5173
VITE_APP_ENV=local
VITE_API_BASE_PATH=/api
VITE_PROXY_TARGET=http://localhost:8080

# OIDC / Keycloak
VITE_OIDC_ISSUER=http://localhost:8081/realms/oems
VITE_OIDC_CLIENT_ID=oems-api
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:5173/auth/silent-callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_SCOPE=openid profile email

# Optional UI flags
VITE_ENABLE_MOCK_AUTH=false
VITE_AUTH_TELEMETRY_ENABLED=true

