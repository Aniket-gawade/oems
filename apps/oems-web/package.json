{
  "name": "oems-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:auth": "playwright test e2e/auth-smoke.spec.ts",
    "e2e:oidc-local": "playwright test e2e/oidc-local.spec.ts",
    "e2e:visual": "playwright test e2e/visual-baseline.spec.ts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "e2e:keyboard": "playwright test e2e/keyboard.spec.ts",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.10",
    "oidc-client-ts": "^3.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.32.3",
    "@testing-library/react": "14.2.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.2.1",
    "caniuse-lite": "^1.0.30001782",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.6",
    "jsdom": "22.1.0",
    "prettier": "3.2.5",
    "typescript": "5.4.3",
    "vite": "4.5.3",
    "vitest": "0.34.6",
    "whatwg-fetch": "^3.6.20"
  }
}
