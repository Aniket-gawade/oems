# API
API_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=staging
OEMS_SECURITY_JWT_EXPECTED_AUDIENCE=oems-api
OEMS_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# MySQL
MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3306
MYSQL_DATABASE=oems
MYSQL_USER=oems_user
MYSQL_PASSWORD=oems_password
MYSQL_ROOT_PASSWORD=oems_root_password

# Redis
REDIS_IMAGE=redis:8.6
REDIS_PORT=6379

# Keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.5
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
