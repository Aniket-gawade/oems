<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <groupId>com.project</groupId>
    <artifactId>oems-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>oems-parent</name>
    <description>Order Execution and Management System monorepo</description>
    <packaging>pom</packaging>

    <modules>
        <module>shared/common</module>
        <module>shared/contracts</module>
        <module>services/api-gateway</module>
        <module>services/order-service</module>
        <module>services/risk-service</module>
        <module>services/execution-sim-service</module>
        <module>services/portfolio-service</module>
        <module>services/reference-data-service</module>
        <module>services/audit-reporting-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
